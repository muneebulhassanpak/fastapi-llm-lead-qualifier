# Copy to .env and fill in. Never commit .env.
# Values shown are the local-development defaults.

# --- App ---
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# --- Database (Phase 03) ---
# Any Postgres URL. Neon's connection string can be pasted as-is (sslmode etc. are converted).
# Local docker-compose Postgres is published on host port 5433.
# docker compose ignores this and always uses its own db container.
DATABASE_URL=postgresql+asyncpg://leadqual:leadqual@localhost:5433/leadqual
# Used only by the test suite. The database is DROPPED and recreated on every test run,
# so never point this at a database you care about.
TEST_DATABASE_URL=postgresql://leadqual:leadqual@localhost:5433/leadqual_test
# Container only: run `alembic upgrade head` before starting the server.
RUN_MIGRATIONS=false
IDEMPOTENCY_TTL_HOURS=24

# --- Security (Phase 03, 08) ---
# Long random strings. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_PEPPER=
# Encrypts stored webhook signing secrets. Changing it means re-creating webhook endpoints.
WEBHOOK_SECRET_KEY=

# --- Worker (Phase 04) ---
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=5
# A job still "running" after this long is assumed lost (crash, restart) and is re-queued.
JOB_LOCK_TIMEOUT_SECONDS=300
# Retries use exponential backoff with jitter: base, 2x base, 4x base, ... capped at max.
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_MAX_SECONDS=600

# --- LLM (Phase 05) ---
# mock scores with keyword rules, offline and free. anthropic/openai need LLM_API_KEY.
LLM_MODE=mock                  # mock | anthropic | openai
# Empty means claude-haiku-5-5 for anthropic. Required for openai.
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Model calls per tenant per UTC day. Over the cap, leads go to review without a call.
LLM_DAILY_CAP=200

# --- Routing thresholds (Phase 05) ---
AUTO_APPROVE_SCORE=60
DISQUALIFY_SCORE=30
MIN_CONFIDENCE=0.75

# --- CRM (Phase 06) ---
# Only the mock CRM ships in v1 (records go to the mock_crm_records table). HubSpot is next.
CRM_MODE=mock
CRM_MAX_ATTEMPTS=5
# Share of mock CRM calls that fail with a 503, to show retries. 0 to 1.
MOCK_CRM_FAIL_RATE=0

# --- Rate limits (Phase 08) ---
# Per API key (and per webhook endpoint, which uses the write limit), per process.
RATE_LIMIT_WRITES_PER_MINUTE=60
RATE_LIMIT_READS_PER_MINUTE=300

# --- Demo data retention (Phase 08) ---
DEMO_RETENTION_DAYS=7
